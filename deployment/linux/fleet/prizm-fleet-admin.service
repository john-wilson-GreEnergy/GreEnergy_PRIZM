# Root master is required for sshd/PAM to start an ebc admin shell.
# This is management, not a telemetry service. Never start in SS4 or Fleet.
[Unit]
Description=GreEnergy PRIZM Solar Star 3 management SSH
BindsTo=prizm-fleet-network.service
After=prizm-fleet-network.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
NetworkNamespacePath=/run/netns/prizm-ss3
RuntimeDirectory=prizm-fleet-admin
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/sshd -t -f /etc/prizm-fleet/admin/sshd.conf
ExecStart=/usr/sbin/sshd -D -e -f /etc/prizm-fleet/admin/sshd.conf
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
