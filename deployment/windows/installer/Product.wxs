<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="GreEnergy PRIZM"
           Manufacturer="GreEnergy Resources LLC"
           Version="$(var.ProductVersion)"
           UpgradeCode="{F1148D34-9D39-4BC0-9A8A-F7A682236A91}"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of GreEnergy PRIZM is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Feature Id="Complete" Title="GreEnergy PRIZM Platform" Level="1">
      <ComponentGroupRef Id="ApplicationPayload" />
      <ComponentRef Id="ProgramDataFolders" />
      <ComponentRef Id="DefaultConfiguration" />
      <ComponentRef Id="PRIZMService" />
      <ComponentRef Id="ManagerComponent" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="GreEnergyProgramFiles" Name="GreEnergy">
        <Directory Id="INSTALLFOLDER" Name="PRIZM">
          <Directory Id="ServiceFolder" Name="service" />
          <Directory Id="ManagerFolder" Name="manager" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="GreEnergyProgramData" Name="GreEnergy">
        <Directory Id="PRIZMData" Name="PRIZM">
          <Directory Id="LogsFolder" Name="Logs" />
          <Directory Id="ConfigFolder" Name="Config" />
          <Directory Id="CacheFolder" Name="Cache" />
          <Directory Id="BackupsFolder" Name="Backups" />
          <Directory Id="TelemetryFolder" Name="Telemetry" />
          <Directory Id="RuntimeFolder" Name="Runtime" />
          <Directory Id="PIDFolder" Name="PID" />
          <Directory Id="UpdatesFolder" Name="Updates" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="GreEnergyMenu" Name="GreEnergy" />
    </StandardDirectory>

    <ComponentGroup Id="ApplicationPayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**" Exclude="$(var.PayloadDir)\service\**;$(var.PayloadDir)\manager\**" />
    </ComponentGroup>

    <Component Id="ManagerComponent" Directory="ManagerFolder" Guid="{46C1788E-F2A5-4961-9D90-DC698E43888D}">
      <File Id="ManagerExecutable" Source="$(var.PayloadDir)\manager\GreEnergy PRIZM Manager.exe" KeyPath="yes" />
    </Component>

    <Component Id="ProgramDataFolders" Directory="PRIZMData" Guid="{E57ED9B6-9014-4B20-93F2-D7AFD1D8A453}" Permanent="yes" NeverOverwrite="yes">
      <CreateFolder>
        <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" />
        <util:PermissionEx User="LOCAL SERVICE" GenericAll="yes" />
      </CreateFolder>
      <CreateFolder Directory="LogsFolder"><util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" /></CreateFolder>
      <CreateFolder Directory="ConfigFolder"><util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" /></CreateFolder>
      <CreateFolder Directory="CacheFolder"><util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" /></CreateFolder>
      <CreateFolder Directory="BackupsFolder"><util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" /></CreateFolder>
      <CreateFolder Directory="TelemetryFolder"><util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" /></CreateFolder>
      <CreateFolder Directory="RuntimeFolder"><util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" /></CreateFolder>
      <CreateFolder Directory="PIDFolder"><util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" /></CreateFolder>
      <CreateFolder Directory="UpdatesFolder"><util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" /></CreateFolder>
      <RegistryValue Root="HKLM" Key="Software\GreEnergy\PRIZM" Name="DataInitialized" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DefaultConfiguration" Directory="ConfigFolder" Guid="{F7C53EA2-BC67-47B8-821D-CBC6F26AD5DA}" Permanent="yes" NeverOverwrite="yes">
      <File Id="DefaultSettings" Source="$(var.PayloadDir)\defaults\settings.json" Name="settings.json" NeverOverwrite="yes" KeyPath="yes" />
    </Component>

    <Component Id="PRIZMService" Directory="ServiceFolder" Guid="{9EED527B-B9D4-45C5-90C6-BF78E2B48FE7}">
      <File Id="WinSWExecutable" Source="$(var.PayloadDir)\service\GreEnergy.PRIZM.Service.exe" KeyPath="yes" />
      <File Id="WinSWConfiguration" Source="$(var.PayloadDir)\service\GreEnergy.PRIZM.Service.xml" />
      <ServiceInstall Id="InstallPRIZMService"
                      Name="GreEnergy PRIZM"
                      DisplayName="GreEnergy PRIZM Platform"
                      Description="GreEnergy Resources Battery Energy Storage Platform"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="NT AUTHORITY\LocalService"
                      Vital="yes">
        <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" PreShutdownDelay="180000" />
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="15"
                            ResetPeriodInDays="1" />
        <util:PermissionEx User="Users" ServiceStart="yes" ServiceStop="yes" ServiceQueryStatus="yes" />
      </ServiceInstall>
      <ServiceControl Id="ControlPRIZMService"
                      Name="GreEnergy PRIZM"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="{2A9C7582-BD4A-4DD4-B521-E640180726E6}">
      <Shortcut Id="DesktopManagerShortcut" Name="GreEnergy PRIZM" Target="[#ManagerExecutable]" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\GreEnergy\PRIZM" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="StartMenuShortcut" Directory="GreEnergyMenu" Guid="{FF70B468-F1EF-45C4-99CE-AB182E06F00D}">
      <Shortcut Id="StartMenuManagerShortcut" Name="GreEnergy PRIZM Manager" Target="[#ManagerExecutable]" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveGreEnergyMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\GreEnergy\PRIZM" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Property Id="ARPHELPLINK" Value="https://www.greenergyresources.com/" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="REMOVEUSERDATA" Value="0" Secure="yes" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch GreEnergy PRIZM Manager" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <CustomAction Id="LaunchManager" FileRef="ManagerExecutable" ExeCommand="" Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchManager"
             Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
  </Package>
</Wix>
